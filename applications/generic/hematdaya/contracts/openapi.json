          "version"
        ],
        "title": "CompositionResponse",
        "type": "object"
      },
      "CreateAssetRequest": {
        "additionalProperties": false,
        "description": "A new asset. Expected use stays unknown unless the user chooses it.",
        "properties": {
          "category": {
            "anyOf": [
              {
                "maxLength": 60,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Category"
          },
          "expected_use": {
            "$ref": "#/components/schemas/ExpectedUse",
            "default": "unknown"
          },
          "location": {
            "anyOf": [
              {
                "maxLength": 60,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Location"
          },
          "name": {
            "maxLength": 60,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "parent_asset_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Parent Asset Id"
          },
          "scope_kind": {
            "$ref": "#/components/schemas/ScopeKind"
          }
        },
        "required": [
          "name",
          "scope_kind"
        ],
        "title": "CreateAssetRequest",
        "type": "object"
      },
      "CreateBindingRequest": {
        "additionalProperties": false,
        "description": "Attribute a source of the same site to an asset from a given instant.",
        "properties": {
          "authoritative": {
            "default": true,
            "title": "Authoritative",
            "type": "boolean"
          },
          "effective_from": {
            "format": "date-time",
            "title": "Effective From",
            "type": "string"
          },
          "source_id": {
            "format": "uuid",
            "title": "Source Id",
            "type": "string"
          }
        },
        "required": [
          "source_id",
          "effective_from"
        ],
        "title": "CreateBindingRequest",
        "type": "object"
      },
      "ErrorBody": {
        "description": "Public failure content.",
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "details": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/ErrorFieldDetail"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Details"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "recovery": {
            "$ref": "#/components/schemas/ErrorRecovery"
          },
          "request_id": {
            "title": "Request Id",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "request_id",
          "recovery"
        ],
        "title": "ErrorBody",
        "type": "object"
      },
      "ErrorEnvelope": {
        "description": "The one failure body on every endpoint.",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorEnvelope",
        "type": "object"
      },
      "ErrorFieldDetail": {
        "description": "One invalid field in a validation failure.",
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Loc",
            "type": "array"
          },
          "msg": {
            "title": "Msg",
            "type": "string"
          },
          "type": {
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ErrorFieldDetail",
        "type": "object"
      },
      "ErrorRecovery": {
        "description": "Retry guidance for one failure.",
        "properties": {
          "max_attempts": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Max Attempts"
          },
          "retry_after_seconds": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Retry After Seconds"
          },
          "retryable": {
            "title": "Retryable",
            "type": "boolean"
          }
        },
        "required": [
          "retryable"
        ],
        "title": "ErrorRecovery",
        "type": "object"
      },
      "ExpectedUse": {
        "description": "How the user expects the asset to run. Never derived from its category.",
        "enum": [
          "unknown",
          "continuous",
          "scheduled",
          "intermittent"
        ],
        "title": "ExpectedUse",
        "type": "string"
      },
      "MeasurementKind": {
        "description": "What a source's raw values mean.",
        "enum": [
          "interval_energy",
          "average_power",
          "instantaneous_power",
          "counter"
        ],
        "title": "MeasurementKind",
        "type": "string"
      },
      "PolicyResponse": {
        "description": "One versioned analysis policy.",
        "properties": {
          "id": {
            "title": "Id",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "version"
        ],
        "title": "PolicyResponse",
        "type": "object"
      },
      "ScopeKind": {
        "description": "What an asset's readings cover.",
        "enum": [
          "device",
          "group",
          "circuit",
          "site_total"
        ],
        "title": "ScopeKind",
        "type": "string"
      },
      "SiteContext": {
        "description": "Neutral by default. Context changes examples only, never calculations.",
        "enum": [
          "household",
          "business",
          "industry",
          "unspecified"
        ],
        "title": "SiteContext",
        "type": "string"
      },
      "SiteKind": {
        "description": "Demo sites run on a virtual clock; standard sites on the wall clock.",
        "enum": [
          "demo",
          "standard"
        ],
        "title": "SiteKind",
        "type": "string"
      },
      "SiteResponse": {
        "description": "A site as clients see it, with the product time it runs on.",
        "properties": {
          "context": {
            "$ref": "#/components/schemas/SiteContext"
          },
          "currency": {
            "title": "Currency",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "kind": {
            "$ref": "#/components/schemas/SiteKind"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "now": {
            "format": "date-time",
            "title": "Now",
            "type": "string"
          },
          "timezone": {
