          "label",
          "origin",
          "measurement_kind",
          "cadence_seconds",
          "resolution_mwh",
          "transport_status"
        ],
        "title": "SourceResponse",
        "type": "object"
      },
      "TransportStatus": {
        "description": "How a source reaches the API. Nothing is ever a real live connection before 046.",
        "enum": [
          "none",
          "simulated_live",
          "historical"
        ],
        "title": "TransportStatus",
        "type": "string"
      },
      "UpdateAssetRequest": {
        "additionalProperties": false,
        "description": "Asset fields an owner may change. Archiving is reversible and keeps readings.",
        "properties": {
          "archived": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Archived"
          },
          "category": {
            "anyOf": [
              {
                "maxLength": 60,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Category"
          },
          "expected_use": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ExpectedUse"
              },
              {
                "type": "null"
              }
            ]
          },
          "location": {
            "anyOf": [
              {
                "maxLength": 60,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Location"
          },
          "name": {
            "anyOf": [
              {
                "maxLength": 60,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          }
        },
        "title": "UpdateAssetRequest",
        "type": "object"
      },
      "UpdateSiteRequest": {
        "additionalProperties": false,
        "description": "Fields an owner may change. Stored UTC instants keep their values when the timezone changes.",
        "properties": {
          "context": {
