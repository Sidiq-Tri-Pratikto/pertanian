  "info": {
    "title": "hematdaya-api",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/assets/{asset_id}": {
      "get": {
        "description": "Return an owned asset, its bindings and their sources.\n\nArgs:\n    asset_id (UUID): The asset.\n    principal (PrincipalModel): The acting principal.\n    service (AssetService): Asset rules.\n\nReturns:\n    AssetDetailResponse: The asset.",
        "operationId": "get_asset_api_v1_assets__asset_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "asset_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Asset Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssetDetailResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Validation failed"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Failure"
          }
        },
        "summary": "Read an asset with its sources",
        "tags": [
          "assets"
        ]
      },
      "patch": {
        "description": "Change an owned asset's name, category, location, expected use or archive state.\n\nArgs:\n    asset_id (UUID): The asset.\n    request (UpdateAssetRequest): The changes.\n    principal (PrincipalModel): The acting principal.\n    service (AssetService): Asset rules.\n\nReturns:\n    AssetResponse: The asset.",
        "operationId": "update_asset_api_v1_assets__asset_id__patch",
        "parameters": [
          {
            "in": "path",
            "name": "asset_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Asset Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateAssetRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssetResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Validation failed"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Failure"
          }
        },
        "summary": "Change an asset",
        "tags": [
          "assets"
        ]
      }
    },
    "/api/v1/assets/{asset_id}/bindings": {
      "post": {
        "description": "Attribute a source of the same site to an owned asset.\n\nArgs:\n    asset_id (UUID): The asset.\n    request (CreateBindingRequest): The binding.\n    principal (PrincipalModel): The acting principal.\n    service (AssetService): Asset rules.\n\nReturns:\n    BindingResponse: The binding.",
        "operationId": "create_binding_api_v1_assets__asset_id__bindings_post",
        "parameters": [
          {
            "in": "path",
            "name": "asset_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Asset Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateBindingRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BindingResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Validation failed"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Failure"
          }
        },
        "summary": "Bind a source",
        "tags": [
          "assets"
        ]
      }
    },
