            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "kind",
          "context",
          "timezone",
          "currency",
          "now"
        ],
        "title": "SiteResponse",
        "type": "object"
      },
      "SourceOrigin": {
        "description": "Where a source's readings come from.",
        "enum": [
          "live",
          "import",
          "dataset_replay",
          "simulated"
        ],
        "title": "SourceOrigin",
        "type": "string"
      },
      "SourceResponse": {
        "description": "A source and how its readings arrive.",
        "properties": {
          "cadence_seconds": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cadence Seconds"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "label": {
            "title": "Label",
            "type": "string"
          },
          "measurement_kind": {
            "$ref": "#/components/schemas/MeasurementKind"
          },
          "origin": {
            "$ref": "#/components/schemas/SourceOrigin"
          },
          "resolution_mwh": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Resolution Mwh"
          },
          "transport_status": {
            "$ref": "#/components/schemas/TransportStatus"
