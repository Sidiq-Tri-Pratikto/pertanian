{
  "components": {
    "schemas": {
      "AdapterResponse": {
        "description": "One data source adapter.",
        "properties": {
          "id": {
            "title": "Id",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/CapabilityStatus"
          }
        },
        "required": [
          "id",
          "status"
        ],
        "title": "AdapterResponse",
        "type": "object"
      },
      "CapabilityManifestResponse": {
        "description": "Non-secret explanation of this deployment. It grants nothing; the service still authorizes every request.",
        "properties": {
          "adapters": {
            "items": {
              "$ref": "#/components/schemas/AdapterResponse"
            },
            "title": "Adapters",
            "type": "array"
          },
          "capabilities": {
            "items": {
              "$ref": "#/components/schemas/CapabilityResponse"
            },
            "title": "Capabilities",
            "type": "array"
          },
          "composition": {
            "$ref": "#/components/schemas/CompositionResponse"
          },
          "policies": {
            "items": {
              "$ref": "#/components/schemas/PolicyResponse"
            },
            "title": "Policies",
            "type": "array"
          },
          "schema_version": {
            "title": "Schema Version",
            "type": "integer"
          },
          "source_release": {
            "title": "Source Release",
            "type": "string"
          }
        },
        "required": [
          "schema_version",
          "source_release",
          "composition",
          "capabilities",
          "adapters",
          "policies"
        ],
        "title": "CapabilityManifestResponse",
        "type": "object"
      },
      "CapabilityResponse": {
        "description": "One product capability.",
        "properties": {
          "id": {
            "title": "Id",
            "type": "string"
          },
          "optional": {
            "title": "Optional",
            "type": "boolean"
          },
          "status": {
            "$ref": "#/components/schemas/CapabilityStatus"
          }
        },
        "required": [
          "id",
          "optional",
          "status"
        ],
        "title": "CapabilityResponse",
        "type": "object"
      },
      "CapabilityStatus": {
        "description": "What a capability or adapter can honestly claim today.",
        "enum": [
          "planned",
          "simulated",
          "available"
        ],
        "title": "CapabilityStatus",
        "type": "string"
      },
      "CompositionResponse": {
        "description": "The validated product composition of this deployment.",
        "properties": {
          "id": {
            "title": "Id",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "version"
        ],
        "title": "CompositionResponse",
        "type": "object"
      },
      "ErrorBody": {
        "description": "Public failure content.",
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "details": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/ErrorFieldDetail"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Details"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "recovery": {
            "$ref": "#/components/schemas/ErrorRecovery"
          },
          "request_id": {
            "title": "Request Id",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "request_id",
          "recovery"
        ],
        "title": "ErrorBody",
        "type": "object"
      },
      "ErrorEnvelope": {
        "description": "The one failure body on every endpoint.",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorEnvelope",
        "type": "object"
      },
      "ErrorFieldDetail": {
        "description": "One invalid field in a validation failure.",
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Loc",
            "type": "array"
          },
          "msg": {
            "title": "Msg",
            "type": "string"
          },
          "type": {
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ErrorFieldDetail",
        "type": "object"
      },
      "ErrorRecovery": {
        "description": "Retry guidance for one failure.",
        "properties": {
          "max_attempts": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Max Attempts"
          },
          "retry_after_seconds": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Retry After Seconds"
          },
          "retryable": {
            "title": "Retryable",
            "type": "boolean"
          }
        },
        "required": [
          "retryable"
        ],
        "title": "ErrorRecovery",
        "type": "object"
      },
      "PolicyResponse": {
        "description": "One versioned analysis policy.",
        "properties": {
          "id": {
            "title": "Id",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "version"
        ],
        "title": "PolicyResponse",
        "type": "object"
      },
      "SiteContext": {
        "description": "Neutral by default. Context changes examples only, never calculations.",
        "enum": [
          "household",
          "business",
          "industry",
          "unspecified"
        ],
        "title": "SiteContext",
        "type": "string"
      },
      "SiteKind": {
        "description": "Demo sites run on a virtual clock; standard sites on the wall clock.",
        "enum": [
          "demo",
          "standard"
        ],
        "title": "SiteKind",
        "type": "string"
      },
      "SiteResponse": {
        "description": "A site as clients see it, with the product time it runs on.",
        "properties": {
          "context": {
            "$ref": "#/components/schemas/SiteContext"
          },
          "currency": {
            "title": "Currency",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "kind": {
            "$ref": "#/components/schemas/SiteKind"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "now": {
            "format": "date-time",
            "title": "Now",
            "type": "string"
          },
          "timezone": {
            "title": "Timezone",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "kind",
          "context",
          "timezone",
          "currency",
          "now"
        ],
        "title": "SiteResponse",
        "type": "object"
      },
      "UpdateSiteRequest": {
        "additionalProperties": false,
        "description": "Fields an owner may change. Stored UTC instants keep their values when the timezone changes.",
        "properties": {
          "context": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SiteContext"
              },
              {
                "type": "null"
              }
            ]
          },
          "name": {
            "anyOf": [
              {
                "maxLength": 60,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          },
          "timezone": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Timezone"
          }
        },
        "title": "UpdateSiteRequest",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "hematdaya-api",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/capabilities": {
      "get": {
        "description": "Return the non-secret manifest clients use to explain what is available.\n\nReturns:\n    CapabilityManifestResponse: The manifest.",
        "operationId": "get_capabilities_api_v1_capabilities_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CapabilityManifestResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Failure"
          }
        },
        "summary": "Describe this deployment",
        "tags": [
          "capabilities"
        ]
      }
    },
    "/api/v1/sites/{site_id}": {
      "get": {
        "description": "Return an owned site.\n\nArgs:\n    site_id (UUID): The site.\n    principal (PrincipalModel): The acting principal.\n    service (SiteService): Site rules.\n\nReturns:\n    SiteResponse: The site.",
        "operationId": "get_site_api_v1_sites__site_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "site_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Site Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SiteResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Validation failed"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Failure"
          }
        },
        "summary": "Read a site",
        "tags": [
          "sites"
        ]
      },
      "patch": {
        "description": "Change an owned site's name, context or timezone.\n\nArgs:\n    site_id (UUID): The site.\n    request (UpdateSiteRequest): The changes.\n    principal (PrincipalModel): The acting principal.\n    service (SiteService): Site rules.\n\nReturns:\n    SiteResponse: The updated site.",
        "operationId": "update_site_api_v1_sites__site_id__patch",
        "parameters": [
          {
            "in": "path",
            "name": "site_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Site Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateSiteRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SiteResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Validation failed"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Failure"
          }
        },
        "summary": "Change site settings",
        "tags": [
          "sites"
        ]
      }
    },
    "/health/live": {
      "get": {
        "description": "Report that the process is serving.\n\nReturns:\n    dict[str, str]: The status.",
        "operationId": "health_health_live_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Health Health Live Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Failure"
          }
        },
        "summary": "Liveness check",
        "tags": [
          "health"
        ]
      }
    },
    "/health/ready": {
      "get": {
        "description": "Report that dependencies are reachable.\n\nArgs:\n    session (SessionDep): Database session.\n\nReturns:\n    dict[str, str]: The status.",
        "operationId": "ready_health_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Ready Health Ready Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Failure"
          }
        },
        "summary": "Readiness check",
        "tags": [
          "health"
        ]
      }
    }
  }
}
