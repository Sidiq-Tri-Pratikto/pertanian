          "archived": {
            "title": "Archived",
            "type": "boolean"
          },
          "bindings": {
            "items": {
              "$ref": "#/components/schemas/BindingResponse"
            },
            "title": "Bindings",
            "type": "array"
          },
          "category": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Category"
          },
          "expected_use": {
            "$ref": "#/components/schemas/ExpectedUse"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "location": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Location"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "parent_asset_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Parent Asset Id"
          },
          "scope_kind": {
            "$ref": "#/components/schemas/ScopeKind"
          },
          "sources": {
            "items": {
              "$ref": "#/components/schemas/SourceResponse"
            },
            "title": "Sources",
            "type": "array"
          }
        },
        "required": [
          "id",
          "name",
          "category",
          "location",
          "scope_kind",
          "parent_asset_id",
          "expected_use",
          "archived",
          "bindings",
          "sources"
        ],
        "title": "AssetDetailResponse",
        "type": "object"
      },
      "AssetPageResponse": {
