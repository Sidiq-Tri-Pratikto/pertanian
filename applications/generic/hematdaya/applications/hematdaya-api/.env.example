SERVICE_NAME=hematdaya-api
ENVIRONMENT=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/app
CORS_ALLOWED_ORIGINS=["http://localhost:8081"]
COMPOSITION=core-plus-optional
DEMO_SESSION_TTL_HOURS=72
DEMO_MAX_ACTIVE_SESSIONS=200
DEMO_CREATE_MAX_PER_MINUTE=30
DEMO_CREATE_REPLAY_SECONDS=300
# Required outside development: a JSON map of versioned secrets, for example {"v1": "<random>"}. Never commit one.
# DEMO_TOKEN_KEYS=
DEMO_TOKEN_KEY_VERSION=v1

# Enable only on an isolated meter lab with an operator-provisioned site.
METER_PILOT_ENABLED=false
# METER_MQTT_HOST=
# METER_MQTT_PORT=8883
# METER_MQTT_CA_FILE=
# METER_MQTT_USERNAME=
# METER_MQTT_PASSWORD=
