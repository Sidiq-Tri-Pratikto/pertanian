SERVICE_NAME=temuriset-api
ENVIRONMENT=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://app:app@localhost:5442/app
# The web client reaches the API through its own origin, so browsers need no CORS entry.
CORS_ALLOWED_ORIGINS=[]
COMPOSITION=generic-base
# JSON object of capabilities to switch on or off on top of the composition, for example {"organization_review": true}.
COMPOSITION_OVERRIDES={}
# Upload scanner: clamav, or development-accept (refused outside development).
FILE_SCANNER=development-accept
# The web client's origin. Unsafe requests that carry a session cookie must come from it.
WEB_ORIGIN=http://localhost:3020
# Email mode: development is local only. Set disabled outside development until real email in spec 042.
MAILBOX_ADAPTER=development
# Private document backend: local (development only) or s3.
STORAGE_ADAPTER=local
# Local folder for uploaded documents; downloads always go through the API gateway.
STORAGE_PATH=.storage
# ClamAV daemon for FILE_SCANNER=clamav.
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
# Labelled demo accounts with fictional data and a reset (spec 021). Outside development it also needs
# DEMO_DEPLOYMENT=true, which marks this deployment as a demonstration.
DEMO_MODE=false
DEMO_DEPLOYMENT=false

# Required for STORAGE_ADAPTER=s3. Inject scoped credentials through the deployment secret store.
S3_ENDPOINT_URL=
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
