SERVICE_NAME=temuriset-api
ENVIRONMENT=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://app:app@localhost:5442/app
# The web client reaches the API through its own origin, so browsers need no CORS entry.
CORS_ALLOWED_ORIGINS=[]
COMPOSITION=generic-base
# JSON object of capabilities to switch on or off on top of the composition, for example {"organization_review": true}.
COMPOSITION_OVERRIDES={}
# Upload scanner: clamav, or development-accept (refused outside development).
FILE_SCANNER=development-accept
# The web client's origin. Unsafe requests that carry a session cookie must come from it.
WEB_ORIGIN=http://localhost:3020
# Email modes: development (table), disabled, or loopback-relay (explicit local testing only).
# Outside development, use disabled. The API and worker must use identical settings.
MAILBOX_ADAPTER=development
# Use a literal loopback endpoint such as http://127.0.0.1:8090/deliver and a synthetic sender.
EMAIL_RELAY_URL=
EMAIL_RELAY_SENDER=
# Generate a distinct Fernet key for local delivery and inject it without tracking its value.
EMAIL_ENVELOPE_KEY=
# Private document backend: local (development only) or s3.
STORAGE_ADAPTER=local
# Local folder for uploaded documents; downloads always go through the API gateway.
STORAGE_PATH=.storage
# ClamAV daemon for FILE_SCANNER=clamav.
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
# Summary relay is off by default. Only a development loopback contract double may use local-relay.
SUMMARY_ADAPTER=off
SUMMARY_RELAY_URL=
SUMMARY_MODEL_ID=
SUMMARY_MODEL_VERSION=
SUMMARY_PROMPT_VERSION=
# Labelled demo accounts with fictional data and a reset (spec 021). Outside development it also needs
# DEMO_DEPLOYMENT=true, which marks this deployment as a demonstration.
DEMO_MODE=false
DEMO_DEPLOYMENT=false

# Required for STORAGE_ADAPTER=s3. Inject scoped credentials through the deployment secret store.
S3_ENDPOINT_URL=
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Synthetic local calendar only. To enable it in development, set all four literal loopback URLs,
# a synthetic client ID and a separately generated Fernet key. Leave the release profile off.
CALENDAR_ADAPTER=off
CALENDAR_CALLBACK_ORIGIN=http://localhost:8020
CALENDAR_AUTHORIZE_URL=
CALENDAR_TOKEN_URL=
CALENDAR_FREEBUSY_URL=
CALENDAR_REVOKE_URL=
CALENDAR_CLIENT_ID=
CALENDAR_SCOPE=freebusy.read
CALENDAR_ENVELOPE_KEY=
