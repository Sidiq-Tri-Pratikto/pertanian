# Copy to a private file. Replace the empty entries using the environment secret store.
TEMURISET_API_IMAGE=
TEMURISET_WEB_IMAGE=
RELEASE_SHA=
# Both the web build argument and runtime use this internal origin.
API_URL=http://api:8000
WEB_ORIGIN=
EDGE_BIND_ADDRESS=127.0.0.1
EDGE_PORT=443
TLS_CERT_FILE=
TLS_KEY_FILE=
DATABASE_URL=
POSTGRES_PASSWORD=
COMPOSITION=generic-base
S3_BUCKET=temuriset-documents
S3_ACCESS_KEY=
S3_SECRET_KEY=
# A private identity file outside the repository, scoped to this bucket.
# Allow the container's mapped SeaweedFS GID 1000 to read it, such as root:1000 mode 0440 on Linux.
S3_CONFIG_FILE=
CLAMAV_NO_FRESHCLAMD=false
# Isolated smoke and approved test use only. Staging keeps both production-safe defaults.
ENVIRONMENT=staging
MAILBOX_ADAPTER=disabled
