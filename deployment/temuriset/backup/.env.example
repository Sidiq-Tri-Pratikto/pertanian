# Load from a protected operator environment. Never commit populated copies.
# backup.sh: source DSN, S3 endpoint/bucket, inventory metadata and quiescence checker.
BACKUP_SOURCE_DATABASE_URL=
BACKUP_SOURCE_S3_ENDPOINT=
BACKUP_SOURCE_S3_BUCKET=
BACKUP_SOURCE_ENVIRONMENT=
BACKUP_RELEASE_SHA=
BACKUP_SCHEMA_VERSION=
BACKUP_QUIESCENCE_CHECK=
# Optional inputs for compose_quiescence.sh. Confirm the external fence before setting yes.
BACKUP_COMPOSE_FILE=
BACKUP_COMPOSE_PROJECT=
BACKUP_COMPOSE_ENV_FILE=
BACKUP_S3_WRITERS_FENCED=
BACKUP_PASSPHRASE_FILE=
BACKUP_DIRECTORY=
BACKUP_RETENTION_DAYS=30
# Restore uses a separate role and credentials. An empty target must be pre-created.
BACKUP_RESTORE_DATABASE_URL=
BACKUP_RESTORE_S3_ENDPOINT=
BACKUP_RESTORE_S3_BUCKET=
# Standard AWS credential environment for the role selected for this invocation.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_DEFAULT_REGION=us-east-1
